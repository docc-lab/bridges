data/*
__pycache*
bin/

# CMake build dir for the cluster validator (regenerated by build.sh)
tools/cluster_validate/build/

# Generated experiment data and run state. Keep curated analyses and figures
# under output/, but do not commit bulky raw results or transient job files.
/output/**/*.csv
/output/**/*.json
/output/**/*.log
/output/**/*.stdout
/output/**/*.exit
/output/**/*.pid
/output/**/*.status
/output/**/*.npz

# Locally built experiment executables occasionally placed in output/.
/output/trace_recon_*
/output/depth_profile_*
